# ============================================
# VARIÁVEIS DE AMBIENTE - RESUMAI
# ============================================
# Este arquivo contém todas as variáveis de ambiente necessárias
# para o funcionamento completo do ResumAI.
# 
# IMPORTANTE: Este é um arquivo de exemplo. NÃO commitar o .env real
# com valores sensíveis no repositório.
# ============================================

# ============================================
# SMTP (Email)
# ============================================
SMTP_HOST=resumai.davidsodre.com
SMTP_PORT=465
SMTP_USER=news@resumai.davidsodre.com
SMTP_PASS=Intel23!!
SMTP_FROM=news@resumai.davidsodre.com

# ============================================
# Stripe (Pagamentos)
# ============================================
# Chaves de produção
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Chaves de teste (para desenvolvimento)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_test_...

# ============================================
# Google Analytics
# ============================================
VITE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# Aplicação
# ============================================
VITE_APP_TITLE=ResumAI
VITE_APP_LOGO=/logo.png

# ============================================
# Variáveis Automáticas do Manus
# ============================================
# As seguintes variáveis são injetadas automaticamente
# pelo Manus e NÃO devem ser configuradas manualmente:
#
# DATABASE_URL - URL de conexão com o banco de dados
# JWT_SECRET - Segredo para geração de tokens JWT
# OAUTH_* - Variáveis de configuração OAuth
#
# ============================================

# ============================================
# Banco de Dados (Manual - apenas se não usar Manus)
# ============================================
# Se você estiver fazendo deploy fora do Manus, configure:
# DATABASE_URL=mysql://user:password@host:port/database

# ============================================
# Segurança
# ============================================
# JWT_SECRET=seu_segredo_super_secreto_aqui
# NODE_ENV=production

# ============================================
# URLs e Domínios
# ============================================
# VITE_API_URL=https://seu-dominio.com/api
# VITE_APP_URL=https://seu-dominio.com

# ============================================
# Webhook do Stripe
# ============================================
# Configurar em: https://dashboard.stripe.com/webhooks
# URL do webhook: https://SEU_DOMINIO/api/stripe/webhook
# Eventos para escutar:
#   - checkout.session.completed
#   - payment_intent.succeeded
